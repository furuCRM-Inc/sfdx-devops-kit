**/jsconfig.json
**/jest.config.js
**/__tests__/**
**/node_modules/**
**/.sfdx/**
**/.sf/**
**/coverage/**
**/playwright-report/**
**/test-results/**
code-analyzer-results.json

# rtk-sf index and generated documentation are development artifacts
.rtk-sf/**

