    "claude-code"
  ],
  "license": "MIT",
  "author": "furuCRM Inc.",
  "homepage": "https://github.com/furuCRM-Inc/sfdx-devops-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furuCRM-Inc/sfdx-devops-kit.git"
  },
  "bugs": {
